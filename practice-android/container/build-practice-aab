#!/usr/bin/env bash
set -euo pipefail

version="${1:-${V7_VERSION:-}}"
version_code="${2:-${V7_VERSION_CODE:-}}"

if [[ $# -gt 2 || -z "${version}" ]]; then
  cat >&2 <<'USAGE'
usage: build-practice-aab <version> [versionCode]

The signing password is read from stdin with masking when run interactively.
You can also supply V7_SIGNING_PASSWORD, V7_VERSION, and optional V7_VERSION_CODE.
The same password deterministically recreates the same P-256 signing key.
USAGE
  exit 2
fi

read_signing_password() {
  if [[ -n "${V7_SIGNING_PASSWORD:-}" ]]; then
    password="${V7_SIGNING_PASSWORD}"
    return
  fi

  password=""
  if [[ -t 0 ]]; then
    local char
    printf 'Signing password: ' >&2
    while IFS= read -r -s -n 1 char; do
      if [[ "${char}" == $'\n' || "${char}" == $'\r' ]]; then
        break
      fi
      if [[ "${char}" == $'\177' || "${char}" == $'\b' ]]; then
        if [[ -n "${password}" ]]; then
          password="${password%?}"
          printf '\b \b' >&2
        fi
        continue
      fi
      password+="${char}"
      printf '*' >&2
    done
    printf '\n' >&2
    return
  fi

  IFS= read -r password || password=""
}

read_signing_password
if [[ -z "${password}" ]]; then
  printf 'Signing password is required.\n' >&2
  exit 2
fi

project_dir="/workspace/practice-android"
signing_dir="/tmp/v7-practice-signing"
keystore="${signing_dir}/v7-practice.p12"
signing_env="${signing_dir}/signing.env"
artifacts_dir="/workspace/artifacts"
root_dir="/workspace"

mkdir -p "$(dirname "${keystore}")" "${artifacts_dir}"
printf '%s' "${password}" | derive-v7-practice-keystore.py "${keystore}" > "${signing_env}"
chmod 600 "${signing_env}"
set -a
# shellcheck disable=SC1090
source "${signing_env}"
set +a
export SIGNING_STORE_FILE="${keystore}"

python3 "${root_dir}/practice-android/container/generate-play-assets.py" \
  --artifacts-dir "${artifacts_dir}" \
  --icons-only

gradle_args=(
  "-Pv7PracticeVersion=${version}"
)
if [[ -n "${version_code}" ]]; then
  gradle_args+=("-Pv7PracticeVersionCode=${version_code}")
fi

cd "${project_dir}"
gradle --no-daemon clean bundleRelease "${gradle_args[@]}"

bundle_path="${project_dir}/app/build/outputs/bundle/release/app-release.aab"
artifact_name="v7-practice-${version}.aab"
cp "${bundle_path}" "${artifacts_dir}/${artifact_name}"

sha256sum "${artifacts_dir}/${artifact_name}" | tee "${artifacts_dir}/${artifact_name}.sha256"

python3 "${root_dir}/practice-android/container/generate-play-assets.py" \
  --artifacts-dir "${artifacts_dir}" \
  --screenshots-only

printf 'AAB: %s\n' "${artifacts_dir}/${artifact_name}"
