<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#3157D5</item>
        <item name="android:navigationBarColor">#FFFFFF</item>
        <item name="android:statusBarColor">#2446B8</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="AppTheme">
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="AppTheme.CommandDialog" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#3157D5</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowMinWidthMajor">88%</item>
        <item name="android:windowMinWidthMinor">94%</item>
    </style>
</resources>
