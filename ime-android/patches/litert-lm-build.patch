+LiteRtLmSession* litert_lm_session_clone(LiteRtLmSession* session) {
+  v7_last_error.clear();
+  if (!session || !session->session) {
+    v7_last_error = "LiteRT-LM source session is unavailable";
+    return nullptr;
+  }
+  auto cloned = session->session->Clone();
+  if (!cloned.ok()) {
+    v7_last_error = cloned.status().ToString();
+    ABSL_LOG(ERROR) << "Failed to clone session: " << cloned.status();
+    return nullptr;
+  }
+  auto* c_session = new LiteRtLmSession;
+  c_session->session = std::move(*cloned);
+  return c_session;
