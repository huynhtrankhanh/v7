{
  "name": "v7-web-test",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build:ui-core": "scripts/build-ui-core-wasm.sh",
    "build:web": "vite build",
    "build": "npm run build:ui-core && npm run build:web",
    "test:unit": "jest",
    "test:rust-ui-core": "cd v7-ui-core && cargo test",
    "test:all": "npm run test:unit && npm run test:rust-ui-core",
    "test:e2e": "npm run build && node scripts/fullstack-e2e.js",
    "test:e2e:v7-piecemeal": "npm run build && node scripts/v7-piecemeal-e2e.js",
    "test:practice-focus": "node scripts/practice-focus-e2e.js",
    "test:keyboard-layout": "npm run build && node scripts/keyboard-layout-e2e.js",
    "test:zoom": "npm run build && node scripts/text-zoom-e2e.js",
    "test": "npm run test:unit"
  },
  "dependencies": {
    "puppeteer": "^24.36.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.1",
    "fast-check": "^3.21.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "node-fetch": "^2.7.0",
    "ts-jest": "^29.3.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
