# Ignore everything by default so the Docker build context stays small and stable.
*

# Unignore the specific directories needed by the Dockerfiles.
!inference-rs/
!data/
data/**
!data/two_syllable_dictionary.txt
!practice-android/
!practice-android/**
!src/
!static/
!scripts/

# Unignore build configuration files.
!Dockerfile
!Dockerfile.practice-android
!docker-compose.yml
!.dockerignore
!package.json
!package-lock.json
!tsconfig.json
!tsconfig.jest.json
!vite.config.ts
!requirements.txt
!train_lm.sh
!preprocess_corpus.py
!preprocess_corpus.cpp

# Keep high-churn/generated content out of the build context even under unignored trees.
**/.gradle/
**/build/
**/dist/
**/node_modules/
**/target/
**/__pycache__/
android-artifacts/
coverage/
lm.binary
*.swp
*.rs.bk
