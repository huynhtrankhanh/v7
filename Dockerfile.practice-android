FROM ubuntu:24.04

ARG ANDROID_COMMANDLINE_TOOLS_ZIP=commandlinetools-linux-11076708_latest.zip
ARG ANDROID_COMMANDLINE_TOOLS_URL=https://dl.google.com/android/repository/${ANDROID_COMMANDLINE_TOOLS_ZIP}
ARG GRADLE_VERSION=8.10.2

ENV DEBIAN_FRONTEND=noninteractive
ENV ANDROID_HOME=/opt/android-sdk
ENV ANDROID_SDK_ROOT=/opt/android-sdk
ENV PATH=/opt/gradle/bin:/opt/android-sdk/cmdline-tools/latest/bin:/opt/android-sdk/platform-tools:${PATH}

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        openjdk-17-jdk \
        python3 \
        python3-pip \
        unzip \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /opt/android-sdk/cmdline-tools /opt/gradle \
    && curl -fsSL "${ANDROID_COMMANDLINE_TOOLS_URL}" -o /tmp/android-commandline-tools.zip \
    && unzip -q /tmp/android-commandline-tools.zip -d /opt/android-sdk/cmdline-tools \
    && mv /opt/android-sdk/cmdline-tools/cmdline-tools /opt/android-sdk/cmdline-tools/latest \
    && rm /tmp/android-commandline-tools.zip \
    && curl -fsSL "https://services.gradle.org/distributions/gradle-${GRADLE_VERSION}-bin.zip" -o /tmp/gradle.zip \
    && unzip -q /tmp/gradle.zip -d /opt \
    && mv "/opt/gradle-${GRADLE_VERSION}"/* /opt/gradle/ \
    && rm /tmp/gradle.zip

RUN yes | sdkmanager --licenses >/dev/null \
    && sdkmanager \
        "platform-tools" \
        "platforms;android-35" \
        "build-tools;35.0.0"

RUN pip3 install --break-system-packages --no-cache-dir cryptography==43.0.3
RUN pip3 install --break-system-packages --no-cache-dir pillow==11.1.0 playwright==1.50.0 \
    && python3 -m playwright install --with-deps chromium

WORKDIR /workspace
COPY . /workspace
COPY practice-android/container/derive-v7-practice-keystore.py /usr/local/bin/derive-v7-practice-keystore.py
COPY practice-android/container/build-practice-aab /usr/local/bin/build-practice-aab
RUN chmod +x /usr/local/bin/derive-v7-practice-keystore.py /usr/local/bin/build-practice-aab \
    && mkdir -p /workspace/artifacts

VOLUME ["/workspace/artifacts"]
CMD ["sleep", "infinity"]
