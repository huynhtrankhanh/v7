FROM node:22

RUN apt-get update \
    && apt-get install -y git socat \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/stripped-plover
RUN git clone https://github.com/huynhtrankhanh/strippedplover.git .
RUN npm install
RUN npm run build

ENV STRIPPED_PLOVER_DB=/data/stripped-plover.sqlite
ENV STRIPPED_PLOVER_PORT=4020

EXPOSE 4020
CMD ["sh", "-c", "socat TCP-LISTEN:${STRIPPED_PLOVER_PORT},reuseaddr,fork EXEC:\"node dist/index.js ${STRIPPED_PLOVER_DB}\",pipes"]
